{%- comment -%}
  MEN'S CARE RO — Product Duration pill (per quantity-breaks card)
  Shows how long the chosen quantity lasts in days.
  Required params: product, quantity
{%- endcomment -%}

{%- liquid
  assign days_per_unit = 0
  case product.handle
    when 'serum-pentru-cresterea-barbii-60ml'
      assign days_per_unit = 40
    when 'spuma-pentru-cresterea-barbii-60ml'
      assign days_per_unit = 45
    when 'ulei-pentru-barba-30ml'
      assign days_per_unit = 60
    when 'serum-pentru-cresterea-parului-60ml'
      assign days_per_unit = 40
    when 'spuma-pentru-cresterea-parului-60ml'
      assign days_per_unit = 45
    when 'kit-barba-crestere-accelerata'
      assign days_per_unit = 40
    when 'kit-barba-crestere-maxima'
      assign days_per_unit = 45
    when 'set-pentru-creșterea-barbii-mega-pack'
      assign days_per_unit = 45
    when 'kit-par-crestere-accelerata'
      assign days_per_unit = 40
    when 'kit-par-crestere-maxima'
      assign days_per_unit = 45
  endcase

  assign total_days = quantity | times: days_per_unit
  assign unit_label = 'zile'
  if total_days == 1
    assign unit_label = 'zi'
  endif
-%}

{%- if total_days > 0 -%}
  <span class="mc-duration">
    <svg class="mc-duration__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7v5l3 2"/>
    </svg>
    <span class="mc-duration__text">Ajunge pentru <strong>{{ total_days }} {{ unit_label }}</strong></span>
  </span>
  <style>
    .mc-duration {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-top: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: #f4ecda;
      color: #2a1f14;
      font-size: 11.5px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.005em;
      width: fit-content;
      max-width: 100%;
      white-space: nowrap;
    }
    .mc-duration__icon { width: 12px; height: 12px; flex-shrink: 0; color: #2a1f14; opacity: 0.85; }
    .mc-duration strong { font-weight: 700; }
    @media (max-width: 749px) {
      .mc-duration { font-size: 10px; padding: 3px 7px; gap: 3px; margin-top: 4px; }
      .mc-duration__icon { width: 10px; height: 10px; }
      .quantity-breaks-container > * { min-width: 0; }
    }
  </style>
{%- endif -%}
